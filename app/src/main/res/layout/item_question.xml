<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#405B9C"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/edtQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Câu hỏi demo"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0BEC5"
            android:background="@null"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/edtOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="A"
            android:textColor="#FFFFFF"
            android:background="@null"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/edtOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="B"
            android:textColor="#FFFFFF"
            android:background="@null"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/edtOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="C"
            android:textColor="#FFFFFF"
            android:background="@null"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/edtOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="D"
            android:textColor="#FFFFFF"
            android:background="@null"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/edtCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Đáp án đúng (A/B/C/D)"
            android:textColor="#FFFFFF"
            android:background="@null"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
